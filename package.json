{
  "name": "enquete-policiere",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jeu d'enquete policiere 3D en vue FPS - 1948, ambiance film noir",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./tests/support/register.mjs --test \"tests/unit/*.test.ts\"",
    "test:browser": "node tests/browser/run.mjs",
    "check": "npm run typecheck && npm run typecheck:tests && npm test"
  },
  "dependencies": {
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
